    "theme": {
      "file": "packages/theme/tokens.css",
      "light": ":root",
      "dark": ":root.dark"
    },
    "artifactUrl": "https://claude.ai/artifact/HQqnhrKxc7crEEKayomxP9"
  },
  "release": {
    "prodWorkflow": "livraison.yml",
    "firstVersion": "0.1.0"
  }
