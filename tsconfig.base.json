{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@personal-os/contracts": ["./packages/contracts/src/index.ts"],
      "@personal-os/contracts/command-catalog.json": [
        "./packages/contracts/src/generated/command-catalog.json"
      ],
      "@personal-os/database": ["./packages/database/src/index.ts"],
      "@personal-os/ui/button": ["./packages/ui/button/src/index.ts"],
      "@personal-os/ui/utils": ["./packages/ui/utils/src/index.ts"],
      "@personal-os/ui/input": ["./packages/ui/input/src/index.ts"],
      "@personal-os/ui/label": ["./packages/ui/label/src/index.ts"],
      "@personal-os/ui/card": ["./packages/ui/card/src/index.ts"],
      "@personal-os/ui/badge": ["./packages/ui/badge/src/index.ts"],
      "@personal-os/ui/select": ["./packages/ui/select/src/index.ts"],
      "@personal-os/ui/dccm": ["./packages/ui/dccm/src/index.ts"],
      "@personal-os/ui/avatar": ["./packages/ui/avatar/src/index.ts"],
      "@personal-os/ui/progress": ["./packages/ui/progress/src/index.ts"],
      "@personal-os/ui/separator": ["./packages/ui/separator/src/index.ts"],
      "@personal-os/ui/table": ["./packages/ui/table/src/index.ts"],
      "@personal-os/ui/checkbox": ["./packages/ui/checkbox/src/index.ts"],
      "@personal-os/ui/switch": ["./packages/ui/switch/src/index.ts"],
      "@personal-os/ui/toggle-group": [
        "./packages/ui/toggle-group/src/index.ts"
      ],
      "@personal-os/ui/field": ["./packages/ui/field/src/index.ts"],
      "@personal-os/ui/kbd": ["./packages/ui/kbd/src/index.ts"],
      "@personal-os/ui/breadcrumb": ["./packages/ui/breadcrumb/src/index.ts"],
      "@personal-os/ui/sheet": ["./packages/ui/sheet/src/index.ts"],
      "@personal-os/ui/tooltip": ["./packages/ui/tooltip/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
