                                      "type": "text",
                                      "id": "IKuOR",
                                      "name": "/* =====================================",
                                      "context": "code",
                                      "fill": "$on-surface",
                                      "content": "/* ==========================================================================\n   PERSONAL OS & DCCM SOUVERAIN • CORE TOKENS SPECIFICATION\n   Target: SvelteKit root cascade + CSS Modules\n   ========================================================================== */\n\n:root,\n.dark {\n  /* Canvas & Surfaces (Zero Pure Black, Deep Midnight Slate) */\n  --color-bg: #10141a;\n  --color-surface: #10141a;\n  --color-surface-dim: #10141a;\n  --color-surface-bright: #353940;\n  --color-surface-container-lowest: #0a0e14;\n  --color-surface-container-low: #181c22;\n  --color-surface-container: #1c2026;\n  --color-surface-container-high: #262a31;\n  --color-surface-container-highest: #31353c;\n\n  /* Action & Primary Accents (Electric Blue) */\n  --color-primary: #adc6ff;\n  --color-primary-container: #4d8eff;\n  --color-on-primary: #002e6a;\n  --color-on-primary-container: #00285d;\n\n  /* System Telemetry & States */\n  --color-success: #4edea3;\n  --color-on-success: #003824;\n  --color-warning: #ffb95f;\n  --color-on-warning: #472a00;\n  --color-error: #ffb4ab;\n  --color-error-container: #93000a;\n\n  /* Text & Outlines */\n  --color-on-surface: #dfe2eb;\n  --color-on-surface-variant: #c2c6d6;\n  --color-outline: #8c909f;\n  --color-outline-variant: #424754;\n\n  /* Radii & Elevation Overlays */\n  --radius-sm: 0.25rem;\n  --radius-md: 0.5rem;\n  --radius-lg: 0.75rem;\n  --radius-full: 9999px;\n  --shadow-elevation-card: 0 1px 8px rgba(0, 0, 0, 0.35);\n  --shadow-elevation-popover: 0 12px 32px -4px rgba(0, 0, 0, 0.65);\n}\n\n/* Reset & Scrollbar Sovereignty */\nhtml, body {\n  background-color: var(--color-bg);\n  color: var(--color-on-surface);\n  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;\n  overscroll-behavior: none;\n}\n::-webkit-scrollbar { display: none; }",
                                      "lineHeight": 1.63,
                                      "fontFamily": "$font-mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
