# Environnement du **poste local** — et de lui seul.
#
# Deux fichiers d'environnement coexistent dans ce projet, et les confondre
# coûte cher :
#
#   - ce fichier-ci, lu par `nx serve`, `prisma` et les tests d'intégration ;
#   - `infra/deploy/stack.env.example`, lu par `docker compose` sur le VPS.
#
# Ils n'ont **aucune variable en commun**. Recopier celui-ci sur le serveur
# laisse compose retomber sur ses valeurs par défaut, en silence : le symptôme
# est alors un conflit de port, alors que la cause est une configuration jamais
# lue.

# --- Poste local : nx serve, prisma, tests ------------------------------
#
# Base de données locale (docker compose up db).
DATABASE_URL="postgresql://personalos:personalos@localhost:5432/personalos?schema=public"

# Base jetable utilisée par les tests d'intégration.
TEST_DATABASE_URL="postgresql://personalos:personalos@localhost:5432/personalos_test?schema=public"

# --- Poste local : `nx serve api` ---------------------------------------
#
# L'API refuse de démarrer sans ces variables, et c'est voulu : une pile qui se
# lève sans savoir authentifier passerait sa vérification de santé.
#
# L'émetteur est écrit avec le nom `authentik` et non `localhost` : c'est la
# chaîne que porte le `iss` des jetons, et elle doit désigner la même chose vue
# du navigateur et vue de l'API. Ajouter à /etc/hosts :
#
#     127.0.0.1 authentik
#
# OIDC_ISSUER="http://authentik:9000/application/o/personal-os/"
# OIDC_CLIENT_ID="personal-os"
# OIDC_CLIENT_SECRET="celui du fournisseur créé dans Authentik"
# OIDC_REDIRECT_URI="http://localhost:4200/api/auth/callback"
# DASHBOARD_URL="http://localhost:4200/"
# AUTH_ALLOWED_EMAILS="vous@exemple.test"
#
# En local le tableau de bord est servi en clair, et un cookie `Secure` ne
# serait tout simplement pas posé. En production, ne jamais y toucher.
# SESSION_COOKIE_SECURE=false

# --- Poste local : pile compose complète --------------------------------
#
# Le docker-compose.yml de la racine lit ces variables et retombe sur les mêmes
# valeurs par défaut si elles sont absentes : en local, les laisser
# commentées ne casse rien. Elles sont ici pour être découvertes.
#
# POSTGRES_PASSWORD n'est lu qu'à la **création du volume**. Le changer sur une
# base déjà initialisée ne change rien côté serveur, mais l'API construira sa
# chaîne de connexion avec la nouvelle valeur et ne se connectera plus.
#
# POSTGRES_USER=personalos
# POSTGRES_PASSWORD=personalos
# POSTGRES_DB=personalos
# API_PORT=3000
# DASHBOARD_PORT=4200
# PORTFOLIO_PORT=4201
# POSTGRES_PORT=5432
# AUTHENTIK_PORT=9000
# AUTHENTIK_TAG=2026.5.6
# AUTHENTIK_POSTGRES_DB=authentik
# AUTHENTIK_POSTGRES_USER=authentik
# AUTHENTIK_POSTGRES_PASSWORD=authentik
# AUTHENTIK_SECRET_KEY=peu-importe-en-local
