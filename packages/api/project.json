{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "command-catalog"
      ],
      "options": {
        "command": "webpack-cli build",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "packages/api"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "openapi": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/openapi.json"
      ],
      "options": {
        "cwd": "packages/api",
        "env": {
          "NODE_ENV": "development"
        },
        "parallel": false,
        "commands": [
          "webpack-cli build --config webpack.openapi.config.js",
          "node ../../dist/packages/api-openapi/main.js openapi.json"
        ]
      }
    },
    "command-catalog": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "openapi"
      ],
      "outputs": [
        "{workspaceRoot}/packages/contracts/src/generated/command-catalog.json"
      ],
      "options": {
        "cwd": "packages/api",
        "command": "node ../../dist/packages/api-openapi/command-catalog.js openapi.json ../contracts/src/generated/command-catalog.json"
      }
    },
    "prune-lockfile": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/packages/api/package.json",
        "{workspaceRoot}/dist/packages/api/pnpm-lock.yaml"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": [
        "build"
      ],
      "cache": true,
      "outputs": [
        "{workspaceRoot}/dist/packages/api/workspace_modules"
      ],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": [
        "prune-lockfile",
        "copy-workspace-modules"
      ],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "packages/api/jest.config.cts"
      }
    },
    "test-integration": {
      "executor": "@nx/jest:jest",
      "cache": false,
      "options": {
        "jestConfig": "packages/api/jest.integration.config.cts",
        "runInBand": true
      }
    }
  }
}
