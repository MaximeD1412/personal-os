# Chargé par Nx pour `nx serve api`, et seulement pour lui : l'API refuse de
# démarrer sans APP_ENV (ADR 0031), et le poste local est une installation de
# développement. Une valeur posée dans le shell l'emporte sur celle-ci ;
# celle du .env de la racine, non : Nx lit ce fichier-ci en premier.
APP_ENV=development
