{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "jest.config.ts",
    "jest.config.cts",
    "jest.integration.config.cts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.integration-spec.ts",
    "src/**/*.d.ts",
    "test/**/*.ts"
  ]
}
