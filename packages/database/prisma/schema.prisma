// Schéma de la base Personal OS.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// Sonde technique du squelette applicatif.
model HealthProbe {
  id         String   @id @default(uuid())
  label      String
  recordedAt DateTime @default(now())
}

/// Compte local associé à un sujet Authentik.
model User {
  id          String    @id @default(uuid())
  /// Sujet OIDC stable et opaque.
  subject     String    @unique
  email       String    @unique
  displayName String?
  createdAt   DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  sessions    Session[]
}

/// Session applicative. Seule l'empreinte du jeton est stockée.
model Session {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

/// Transaction OIDC temporaire contenant l'état et les valeurs PKCE.
model LoginTransaction {
  id           String   @id @default(uuid())
  state        String
  nonce        String
  codeVerifier String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}
