// Schéma de la base Personal OS.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// Sonde technique du squelette applicatif.
model HealthProbe {
  id         String   @id @default(uuid())
  label      String
  recordedAt DateTime @default(now())
}

/// Le compartiment auquel appartient une donnée. Personnel, ou celui du Foyer.
enum ScopeKind {
  PERSONAL
  HOUSEHOLD
}

/// Rôle d'un Compte dans un Foyer. La relation est prête pour les invitations
/// et les droits sans enfermer le domaine dans un seul foyer global.
enum HouseholdRole {
  MEMBER
  ADMIN
}

/// Un Foyer : les personnes qui vivent ensemble. Le foyer historique est posé
/// par migration ; les appartenances explicites permettent d'en ajouter.
model Household {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  /// Relation héritée, conservée pendant la fenêtre de compatibilité avec la
  /// version qui portait directement User.householdId.
  legacyUsers User[] @relation("LegacyHouseholdUsers")
  members      HouseholdMember[]
  scopes       Scope[]
}

/// Appartenance explicite d'un Compte à un Foyer. Elle remplace
/// progressivement la relation singulière User.householdId.
model HouseholdMember {
  id          String        @id @default(uuid())
  householdId String
  userId      String
  role        HouseholdRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@index([userId])
}

/// L'Espace, seule chose qui détermine qui voit une donnée. Un Compte possède
/// un Espace personnel et peut atteindre les Espaces de ses Foyers.
model Scope {
  id          String    @id @default(uuid())
  kind        ScopeKind
  label       String
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// Le Compte dont c'est l'Espace personnel ; vide pour l'Espace foyer.
  holderId    String?   @unique
  holder      User?     @relation(fields: [holderId], references: [id], onDelete: Cascade)
  traces      Trace[]

  @@index([householdId])
}

/// Compte local associé à un sujet Authentik.
model User {
  id            String    @id @default(uuid())
  /// Sujet OIDC stable et opaque.
  subject       String    @unique
  email         String    @unique
  displayName   String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  sessions      Session[]
  /// Relation héritée : la valeur par défaut laisse la version précédente de
  /// l'API créer des Comptes sans connaître HouseholdMember (ADR 0024).
  householdId   String    @default("11111111-1111-4111-8111-111111111111")
  household     Household @relation("LegacyHouseholdUsers", fields: [householdId], references: [id])
  memberships   HouseholdMember[]
  personalScope Scope?
}

/// Entité jouet du fil traceur de l'issue #6 : elle porte un Espace et ne sert
/// qu'à démontrer le cloisonnement de bout en bout, jusque dans l'interface.
/// Elle disparaîtra le jour où un vrai module portera un Espace.
model Trace {
  id        String   @id @default(uuid())
  label     String
  scopeId   String
  scope     Scope    @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([scopeId])
}

/// Session applicative. Seule l'empreinte du jeton est stockée.
model Session {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

/// Transaction OIDC temporaire contenant l'état et les valeurs PKCE.
model LoginTransaction {
  id           String   @id @default(uuid())
  state        String
  nonce        String
  codeVerifier String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}
