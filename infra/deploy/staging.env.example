# Environnement du staging de démonstration (ADR 0031). S'installe en
# /opt/personal-os-staging/.env, en mode 600, et n'entre JAMAIS dans Git.
#
# C'est le fichier que lit docker-compose.staging.yml. Il ne partage rien avec
# celui de la prod (/opt/personal-os/.env) : ni mot de passe, ni secret OIDC.
# Recopier l'un pour l'autre est précisément l'erreur que les garde-fous
# ci-dessous arrêtent.

# --- Installation -------------------------------------------------------
#
# `staging`, et rien d'autre. deploy-staging.sh refuse un fichier qui ne le
# pose pas, et l'API ne démarre que sur development, staging ou production.
APP_ENV=staging

# --- Base de données ----------------------------------------------------
#
# Le PostgreSQL du staging, dans son propre projet et son propre volume
# (`staging-db-data`). Il n'a jamais de copie de la prod, ni de sauvegarde :
# deploy-staging.sh le réinitialise à partir du jeu de démo à chaque
# déploiement. Un mot de passe à lui : `openssl rand -hex 32`.
POSTGRES_USER=personalos
POSTGRES_PASSWORD=
POSTGRES_DB=personalos

# L'hôte est `staging-db`, l'alias de la base du staging sur son propre réseau.
# Reporter ici le mot de passe ci-dessus.
DATABASE_URL=postgresql://personalos:<POSTGRES_PASSWORD>@staging-db:5432/personalos?schema=public

# Les adresses de la base de **production**, séparées par des virgules
# (`hôte` ou `hôte:port`). L'API de staging refuse de démarrer si
# DATABASE_URL en désigne une : c'est le filet sous une copie de stack.env.
# Sans cette variable, elle ne démarre pas non plus.
PROD_DATABASE_HOST=db,personal-os-db,127.0.0.1:5433,localhost:5433

# --- Ports publiés ------------------------------------------------------
#
# L'API sur loopback, pour la sonde de santé de deploy-staging.sh seulement
# (STAGING_HEALTH_URL dans deploy.conf). Distinct de tous ceux de la prod.
STAGING_API_PORT=3101

# --- Authentification ---------------------------------------------------
#
# L'Authentik de la prod, par un client OIDC **dédié** au staging : son propre
# slug, son propre secret, sa propre URI de redirection. Les deux comptes du
# foyer y sont liés, comme au client de la prod.
OIDC_ISSUER=https://auth.exemple.fr/application/o/personal-os-staging/
OIDC_CLIENT_ID=personal-os-staging
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://staging.exemple.fr/api/auth/callback
DASHBOARD_URL=https://staging.exemple.fr/

# Les deux comptes du foyer, qui ouvrent une session sur le staging…
AUTH_ALLOWED_EMAILS=
# … et pour qui le jeu de démo sème ses données, dans le même ordre (A, B).
DEMO_ACCOUNT_EMAILS=

# --- IA et stockage -----------------------------------------------------
#
# Le double de test : le staging n'appelle aucun modèle, et ne dépense rien.
AI_PROVIDER=factice

# Le disque du conteneur : ses fichiers disparaissent au déploiement suivant,
# comme tout le reste du staging. Aucune clé du bucket de la prod ici.
STORAGE_PROVIDER=disk
