# Environnement de la pile de production. S'installe en /opt/personal-os/.env,
# en mode 600, et n'entre JAMAIS dans Git.
#
# C'est le fichier que docker compose lit. Ne pas le confondre avec le
# .env.example de la racine, qui ne documente que `nx serve` sur le poste
# local : les recopier l'un pour l'autre laisse compose retomber sur ses
# valeurs par défaut, en silence.

# --- Base de données ----------------------------------------------------
#
# POSTGRES_PASSWORD n'est lu qu'à la **création du volume**. Le changer sur une
# base déjà initialisée ne change rien côté serveur, mais l'API construira sa
# chaîne de connexion avec la nouvelle valeur et ne se connectera plus.
POSTGRES_USER=personalos
POSTGRES_PASSWORD=
POSTGRES_DB=personalos

# --- Ports publiés ------------------------------------------------------
#
# Le compose de production lie tout sur 127.0.0.1 : ces numéros ne sont donc
# pas une question de sécurité mais de disponibilité. Le VPS n'est pas dédié —
# le projet `mairie` y occupe déjà 80, 443, 3000 et 5432, et un bind sur
# 0.0.0.0 occupe le port sur toutes les interfaces, loopback compris.
#
# Réservé pour Authentik (#5) : 9000.
API_PORT=3001
DASHBOARD_PORT=4200
PORTFOLIO_PORT=4201
POSTGRES_PORT=5433

# Port de débogage du Caddy interne, sur loopback. Le proxy de tête ne passe
# **pas** par là : il joint le conteneur par son nom sur le réseau partagé, un
# conteneur ne pouvant pas atteindre un port publié sur le loopback de l'hôte.
CADDY_PORT=8080

# --- Réseau du proxy de tête ---------------------------------------------
#
# Réseau Docker partagé avec l'edge (ADR 0025). Il est créé par le projet de
# l'edge, qui doit donc être démarré en premier.
EDGE_NETWORK=edge

# --- Hôtes --------------------------------------------------------------
#
# Noms servis par le Caddy interne. L'edge lui transmet **tout le domaine** en
# conservant l'en-tête Host — c'est ici qu'on décide quoi en faire, et c'est ce
# qui permet d'ajouter un sous-domaine sans toucher à l'edge.
PORTFOLIO_HOST=portfolio.exemple.fr

# Laissé vide tant que #5 (Authentik) n'est pas livrée : le tableau de bord n'a
# aucune authentification propre, et son nginx relaie /api/ vers l'API.
DASHBOARD_HOST=

# --- API ----------------------------------------------------------------
#
# Le tableau de bord appelle l'API sous son propre hôte, via son nginx : en
# production il n'y a aucune requête inter-origine à autoriser. Laisser vide.
CORS_ORIGINS=
