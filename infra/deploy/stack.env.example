# Environnement de la pile de production. S'installe en /opt/personal-os/.env,
# en mode 600, et n'entre JAMAIS dans Git.
#
# C'est le fichier que docker compose lit. Ne pas le confondre avec le
# .env.example de la racine, qui ne documente que `nx serve` sur le poste
# local : les recopier l'un pour l'autre laisse compose retomber sur ses
# valeurs par défaut, en silence.

# --- Base de données ----------------------------------------------------
#
# POSTGRES_PASSWORD n'est lu qu'à la **création du volume**. Le changer sur une
# base déjà initialisée ne change rien côté serveur, mais l'API construira sa
# chaîne de connexion avec la nouvelle valeur et ne se connectera plus.
POSTGRES_USER=personalos
POSTGRES_PASSWORD=
POSTGRES_DB=personalos

# Authentik a sa propre base sur le **même** serveur (ADR 0015). Le rôle et la
# base sont créés au démarrage par le service db-init, de façon idempotente :
# rien à faire à la main, ni sur un volume neuf ni sur celui d'aujourd'hui.
#
# Le mot de passe est réappliqué à chaque déploiement : le changer ici suffit à
# le changer en base. Le générer avec `openssl rand -hex 32`.
AUTHENTIK_POSTGRES_DB=authentik
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_PASSWORD=

# --- Ports publiés ------------------------------------------------------
#
# Le compose de production lie tout sur 127.0.0.1 : ces numéros ne sont donc
# pas une question de sécurité mais de disponibilité. Le VPS n'est pas dédié —
# le projet `mairie` y occupe déjà 80, 443, 3000 et 5432, et un bind sur
# 0.0.0.0 occupe le port sur toutes les interfaces, loopback compris.
#
API_PORT=3001
DASHBOARD_PORT=4200
PORTFOLIO_PORT=4201
POSTGRES_PORT=5433
AUTHENTIK_PORT=9000

# Port de débogage du Caddy interne, sur loopback. Le proxy de tête ne passe
# **pas** par là : il joint le conteneur par son nom sur le réseau partagé, un
# conteneur ne pouvant pas atteindre un port publié sur le loopback de l'hôte.
CADDY_PORT=8080

# --- Réseau du proxy de tête ---------------------------------------------
#
# Réseau Docker partagé avec l'edge (ADR 0025). Il est créé par le projet de
# l'edge, qui doit donc être démarré en premier.
EDGE_NETWORK=edge

# --- Hôtes --------------------------------------------------------------
#
# Noms servis par le Caddy interne. L'edge lui transmet **tout le domaine** en
# conservant l'en-tête Host — c'est ici qu'on décide quoi en faire, et c'est ce
# qui permet d'ajouter un sous-domaine sans toucher à l'edge.
PORTFOLIO_HOST=portfolio.exemple.fr

# Ces deux-là ne sont plus facultatifs depuis #5 : leurs blocs sont chargés par
# le glob conf.d/*.caddy, et un nom vide donne une adresse de site que Caddy
# refuse — le proxy interne ne démarre alors pas du tout, portfolio compris.
DASHBOARD_HOST=app.exemple.fr
AUTHENTIK_HOST=auth.exemple.fr

# --- API ----------------------------------------------------------------
#
# Le tableau de bord appelle l'API sous son propre hôte, via son nginx : en
# production il n'y a aucune requête inter-origine à autoriser. Laisser vide.
CORS_ORIGINS=

# --- Authentification (ADR 0015) ----------------------------------------
#
# L'API est un client OIDC ordinaire : elle échange le code d'autorisation,
# puis émet **sa propre** session serveur. Aucun jeton d'Authentik n'atteint le
# navigateur.
#
# OIDC_ISSUER est le nom **public** d'Authentik, barre finale comprise : c'est
# la chaîne que porte le `iss` des jetons, et la comparaison y est littérale.
# Elle doit correspondre exactement à ce que publie
# https://auth.exemple.fr/application/o/personal-os/.well-known/openid-configuration
OIDC_ISSUER=https://auth.exemple.fr/application/o/personal-os/

# Le Client ID du **fournisseur**, et son secret.
#
# Ce n'est PAS le slug de l'application, qui ne sert qu'à bâtir l'émetteur
# ci-dessus. Authentik tire le Client ID au hasard à la création du fournisseur
# — quarante caractères — et l'affiche sur sa page de vue, carte « Info ». Le
# secret, lui, n'est visible que dans le formulaire d'édition, et seulement si
# le Client type est « Confidential ».
#
# Y mettre le slug donne « The client identifier (client_id) is missing or
# invalid », rendu par Authentik sur sa propre page : rien n'apparaît dans les
# journaux de l'API, qui n'a pas encore été rappelée.
#
# Le secret est un secret : ce fichier est en mode 600 et n'entre jamais dans Git.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Recopié mot pour mot dans les « Redirect URIs » du fournisseur Authentik. Un
# écart d'une barre oblique fait refuser le retour, sans autre explication
# qu'un « invalid redirect ».
OIDC_REDIRECT_URI=https://app.exemple.fr/api/auth/callback

# Où le navigateur atterrit une fois la session émise.
DASHBOARD_URL=https://app.exemple.fr/

# Toute la politique d'admission tient ici : les adresses des deux comptes du
# foyer, séparées par des virgules. Une identité valide chez Authentik mais
# absente de cette liste n'ouvre rien et **ne crée aucune rangée** — il n'y a
# pas de parcours d'inscription, pas même involontaire.
#
# Les comptes eux-mêmes se créent à la main dans Authentik. Cette liste dit
# lesquels entrent ici ; elle ne les crée pas.
AUTH_ALLOWED_EMAILS=

# --- Authentik ----------------------------------------------------------
#
# Clé de chiffrement d'Authentik. La perdre rend illisibles les secrets qu'il
# détient. `openssl rand -base64 60` la produit.
AUTHENTIK_SECRET_KEY=

# Version épinglée. Ne pas suivre un tag mouvant : une montée de version de
# l'IdP au milieu d'un déploiement ferait tomber la connexion pour une raison
# sans rapport avec ce qui est déployé.
AUTHENTIK_TAG=2026.5.6

# Ses données, en montage lié pour que la sauvegarde puisse les emporter :
# BACKUP_PATHS prend des chemins, pas des volumes Docker.
AUTHENTIK_DIR=/opt/personal-os/authentik
