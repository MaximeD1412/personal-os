# Environnement du proxy de tête. S'installe en /opt/edge/.env, en mode 600,
# et n'entre JAMAIS dans Git.

# Adresse utilisée par l'autorité de certification pour prévenir d'une
# expiration imminente. C'est le seul canal par lequel on apprend qu'un
# renouvellement automatique a cessé de fonctionner.
ACME_EMAIL=

# --- Personal OS ---------------------------------------------------------
#
# Le domaine, sans point ni joker : le Caddyfile compose lui-même
# `*.<domaine>` et `<domaine>`.
PERSONAL_OS_DOMAIN=dccm.fr

# Nom du conteneur du proxy interne, sur le réseau partagé. Pas une adresse IP :
# elle changerait au prochain redémarrage.
PERSONAL_OS_UPSTREAM=personal-os-caddy:80

# --- Identifiants DNS OVH ------------------------------------------------
#
# Nécessaires au challenge DNS-01, seul chemin vers un certificat joker.
#
# Ce jeton ne donne accès qu'à la **zone DNS** : ni au serveur, ni aux données.
# Le créer sur https://api.ovh.com/createToken/ avec ces droits, et rien
# d'autre :
#
#   GET    /domain/zone/dccm.fr/*
#   POST   /domain/zone/dccm.fr/record
#   DELETE /domain/zone/dccm.fr/record/*
#   POST   /domain/zone/dccm.fr/refresh
#
# Laisser la validité illimitée : un jeton qui expire fait échouer un
# renouvellement six mois plus tard, sans que rien ne l'ait annoncé.
OVH_ENDPOINT=ovh-eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# --- Divers --------------------------------------------------------------
#
# Nom du réseau Docker partagé. Les locataires le déclarent en réseau externe
# sous ce même nom.
EDGE_NETWORK=edge

# Image de l'edge. Publiée par la livraison de Personal OS — le dépôt où elle
# vit — mais tirée à la main : l'agent ne déploie pas l'edge (ADR 0025).
EDGE_IMAGE=ghcr.io/maximed1412/personal-os/edge
EDGE_TAG=main
