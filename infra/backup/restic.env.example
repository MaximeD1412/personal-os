# Secrets Restic — modèle.
#
# NE JAMAIS COMMITER LE FICHIER RENSEIGNÉ.
#
# S'installe en /etc/personal-os/restic.env, root:root, mode 600. Les valeurs
# sont générées et saisies sur la machine, et n'en sortent pas : ni CI, ni
# gestionnaire de mots de passe synchronisé, ni copier-coller depuis le poste
# de développement (ADR 0020).
#
# La seule copie hors machine autorisée est une copie *hors ligne* de la clé —
# papier dans un coffre. Sans elle, la perte du serveur rend le dépôt
# définitivement illisible : la sauvegarde existe mais ne vaut plus rien.

# Adresse du dépôt : backend, bucket, chemin.
RESTIC_REPOSITORY=b2:personal-os-restic-CHANGEME:/

# Chemin du fichier contenant la clé, jamais la clé elle-même : une variable
# d'environnement se lit dans /proc/<pid>/environ et dans `systemctl show`.
#
#   openssl rand -base64 48 > /etc/personal-os/restic-password
#   chmod 600 /etc/personal-os/restic-password
RESTIC_PASSWORD_FILE=/etc/personal-os/restic-password

# Clé applicative Backblaze restreinte à ce bucket — jamais la clé maître du
# compte, qui ne peut pas être révoquée isolément.
B2_ACCOUNT_ID=CHANGEME
B2_ACCOUNT_KEY=CHANGEME
